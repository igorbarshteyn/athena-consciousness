{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/igorbarshteyn/athena-consciousness/aibom/schema/athena-graph-1.0.schema.json",
  "title": "Athena AIBOM graph companion 1.0 (project-specific; not a CycloneDX extension)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "header",
    "nodes",
    "zones",
    "boundaries",
    "flows",
    "behaviors",
    "lineage",
    "protocols",
    "gaps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "Athena AIBOM graph companion"
    },
    "format_version": {
      "const": "1.0"
    },
    "header": {
      "type": "object",
      "required": [
        "document_id",
        "revision",
        "system",
        "graph_type",
        "prepared_on",
        "generation_method",
        "prepared_by",
        "responsible_maintainer",
        "maintainer_review",
        "approval",
        "completeness",
        "validity",
        "deployment_observation",
        "source_revisions",
        "scope",
        "views",
        "encoding"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "completeness": {
          "enum": [
            "partial",
            "complete",
            "unknown"
          ]
        },
        "deployment_observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bom_ref",
          "name",
          "zone",
          "membership",
          "role",
          "evidence_refs",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bom_ref": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "zone": {
            "type": "string",
            "minLength": 1
          },
          "membership": {
            "enum": [
              "constituent",
              "external-lineage",
              "external-interface",
              "external-supplier"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "control",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "zones",
          "meaning",
          "flow_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "zones": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "flow_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "kind",
          "payload",
          "condition",
          "protocol",
          "phase",
          "encryption",
          "observation",
          "evidence_refs",
          "boundary_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "data",
              "control",
              "event",
              "message"
            ]
          },
          "payload": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "runtime",
              "build"
            ]
          },
          "encryption": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boundary_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actor_ref",
          "role",
          "model_refs",
          "triggers",
          "actions",
          "permissions",
          "limits",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actor_ref": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "model_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "triggers": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "permissions": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_ref",
          "ancestor_ref",
          "relationship",
          "evidence_refs",
          "claim_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "ancestor_ref": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "mcp",
        "a2a",
        "hosted_llm"
      ],
      "properties": {
        "native": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mcp": {
          "type": "string",
          "minLength": 1
        },
        "a2a": {
          "type": "string",
          "minLength": 1
        },
        "hosted_llm": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "finding",
          "closure",
          "affected_refs",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "closed",
              "accepted-limitation"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "closure": {
            "type": "string",
            "minLength": 1
          },
          "affected_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
